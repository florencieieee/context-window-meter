{
  "manifest_version": 3,
  "name": "ChatGPT Context Window Usage Tracker",
  "version": "1.0.0",
  "description": "Real-time context window token usage counter for ChatGPT chats.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_script.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "ChatGPT Token Usage Tracker"
  }
}
